# نمونهٔ تنظیمات محیطی — برای اجرای محلی این فایل را به .env کپی کنید.
# روی سرور، نصب‌کننده به‌طور خودکار /opt/channel-ads/app.env را می‌سازد.

PORT=8787
HOST=127.0.0.1
DATA_DIR=./data

# فقط در اولین اجرا استفاده می‌شود (وقتی هیچ کاربری وجود ندارد).
# اگر ADMIN_PASSWORD خالی بماند، یک رمز امن ساخته و در ترمینال چاپ می‌شود.
ADMIN_USER=admin
ADMIN_PASSWORD=

# پشت nginx یا هر ریورس‌پروکسی دیگر روی ۱ بگذارید
TRUST_PROXY=1

# وقتی سایت روی HTTPS سرو می‌شود روی ۱ بگذارید
SECURE_COOKIE=0

SESSION_DAYS=30
LOG_REQUESTS=0
